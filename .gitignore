# ============================
# Dependencies
# ============================
node_modules/
**/node_modules/

# ============================
# Environment variables (never commit secrets/API keys)
# ============================
.env
.env.local
.env.*.local
**/.env

# ============================
# Next.js (my-app/)
# ============================
my-app/.next/
my-app/out/
my-app/next-env.d.ts
**/.next/

# ============================
# Node / TypeScript backend (server-web/)
# ============================
server-web/dist/
**/dist/
*.tsbuildinfo

# ============================
# Python (server-agent/)
# ============================
**/__pycache__/
**/.venv/
**/venv/
*.pyc
*.pyo

# ============================
# Logs
# ============================
*.log
npm-debug.log*

# ============================
# OS junk
# ============================
.DS_Store
Thumbs.db

# ============================
# Editor
# ============================
.vscode/*
!.vscode/extensions.json

# ============================
# Reference images (not part of the app)
# ============================
c.jpg
Screenshot-from-*.webp
wallpy-2.jpg

# Note: uv.lock, package-lock.json, and pyproject.toml are intentionally
# NOT ignored — these should be committed for reproducible installs.